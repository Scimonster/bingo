{
  "name": "bingo",
  "private": true,
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22.17"
  },
  "scripts": {
    "build": "pnpm --filter @bingo/web build",
    "build:functions": "pnpm --filter functions build",
    "dev": "pnpm --filter @bingo/web dev",
    "emulators": "pnpm build:functions && firebase emulators:start --project demo-bingo --import .emulator-data --export-on-exit .emulator-data",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --filter=!functions --filter=!@bingo/rules-tests test",
    "test:emulators": "pnpm build:functions && firebase emulators:exec --project demo-bingo --only auth,firestore,storage \"pnpm --filter @bingo/rules-tests test && pnpm --filter functions test\"",
    "admin:set": "node functions/scripts/set-admin.mjs",
    "test:all": "pnpm typecheck && pnpm test && pnpm test:emulators"
  },
  "devDependencies": {
    "firebase-tools": "^15.36.0",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
